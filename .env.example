# Copy this file to .env and replace every value before launch.
# Vite only exposes variables that start with VITE_.

# Business WhatsApp number, digits only, with country code and no "+".
# Nigerian example: 2348012345678 (a local 0801... format is also accepted).
VITE_WHATSAPP_NUMBER=2348000000000

# Optional contact details. Leave a value empty to hide that item.
VITE_CONTACT_EMAIL=hello@example.com
VITE_CONTACT_PHONE=+234 800 000 0000
VITE_CONTACT_LOCATION=Nigeria
VITE_INSTAGRAM_HANDLE=diamondagesolutions
